# ============================================================
# VecinoMarket — Variables de Entorno
# Copia este archivo como .env y completa los valores
# ============================================================

# Django
DJANGO_SECRET_KEY=cambia-esto-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Strangler Pattern: 'flask' en Docker, 'console' en local sin Docker
NOTIFIER_BACKEND=flask

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Google Gemini AI (Adapter Pattern)
# Obtén tu API key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Servicio Aliado
ALLIED_SERVICE_URL=http://allied-service:8001/api/
